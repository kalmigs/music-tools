{
  "name": "music-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsc scripts/drumLooper.generator.ts --module nodenext --moduleResolution nodenext --target es2022 --outDir .tmp/generators && node .tmp/generators/drumLooper.generator.js",
    "prebuild": "pnpm exec tsc scripts/drumLooper.generator.ts --module nodenext --moduleResolution nodenext --target es2022 --outDir .tmp/generators && node .tmp/generators/drumLooper.generator.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/zod-adapter": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.563.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tone": "^15.1.22",
    "vaul-base": "^1.0.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tanstack/router-plugin": "^1.168.24",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5",
      "serialize-javascript": ">=7.0.3",
      "flatted": "3.4.2",
      "picomatch@^2": "2.3.2",
      "picomatch@^4": "4.0.4",
      "fast-uri": ">=3.1.5 <4.0.0",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4 <8.0.0"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
